# Backend
NOTEBOOK_HOST=127.0.0.1
NOTEBOOK_PORT=8000
NOTEBOOK_DATA_DIR=./data
NOTEBOOK_MAX_UPLOAD_MB=50
# Comma-separated formats accepted by the upload validator.
NOTEBOOK_ALLOWED_EXTENSIONS=.pptx,.pdf,.docx
# OCR is opt-in. The parser records a review warning when a page has no text layer.
NOTEBOOK_OCR_ENABLED=false
NOTEBOOK_OCR_MAX_PAGES=10
NOTEBOOK_OCR_LANGUAGE=chi_sim+eng

# DeepSeek is optional. Leave the key empty to use local extraction/retrieval fallback.
# The key is read only by the backend and must never use a VITE_ prefix.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60

# Optional Tavily web search. Leave empty to keep search disabled.
# Course topic names and questions will be sent to Tavily when this is configured.
TAVILY_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=20

# Optional OpenAI-compatible embedding service. DeepSeek is used for generation;
# configure embeddings separately when semantic vector retrieval is available.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
