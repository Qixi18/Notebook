# Backend
NOTEBOOK_HOST=127.0.0.1
NOTEBOOK_PORT=8000
NOTEBOOK_DATA_DIR=./data
NOTEBOOK_MAX_UPLOAD_MB=50

# DeepSeek is optional. Leave the key empty to use local extraction/retrieval fallback.
# The key is read only by the backend and must never use a VITE_ prefix.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60

# Optional OpenAI-compatible embedding service. DeepSeek is used for generation;
# configure embeddings separately when semantic vector retrieval is available.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ---- 设置面板写入安全策略 ----
# 默认关闭密钥写入：设置面板只能修改模型名 / 地址 / 超时 / 上传上限等非敏感项。
# 如需允许通过面板写入 DEEPSEEK_API_KEY、EMBEDDING_API_KEY，必须同时满足：
#   1) 将 NOTEBOOK_ALLOW_SECRET_WRITE 设为 true
#   2) 配置 NOTEBOOK_SETTINGS_TOKEN，并在面板中正确输入该口令
# 未配置 token 时，密钥写入一律拒绝，避免本地服务被任意页面静默改写密钥。
NOTEBOOK_ALLOW_SECRET_WRITE=false
NOTEBOOK_SETTINGS_TOKEN=
